ARG PYTHON_IMAGE=python:3.13-slim
FROM ${PYTHON_IMAGE}

ARG WHEEL
RUN --mount=type=bind,source=${WHEEL},target=/tmp/${WHEEL} \
    python -m venv /opt/venv \
    && /opt/venv/bin/pip install --no-cache-dir /tmp/${WHEEL}

# What the venv's activate script does: VIRTUAL_ENV names it, and its bin comes first on the PATH.
ENV VIRTUAL_ENV=/opt/venv
ENV PATH=$VIRTUAL_ENV/bin:$PATH
