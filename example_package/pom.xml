<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.github.realms42</groupId>
    <artifactId>example-project</artifactId>
    <version>1.0.0-SNAPSHOT</version>

    <!-- Supplied by the plugin below, not by Maven itself. -->
    <packaging>python</packaging>

    <name>Example Python Project</name>
    <description>Example package built by the python-maven-plugin</description>

    <build>
        <!--
            Loading the plugin as a build extension is what makes <packaging>python</packaging>
            resolvable: an extension is read while the POM is still being built, so the plugin's
            META-INF/plexus/components.xml can register the "python" artifact handler and the
            lifecycle that binds copy-sources, generate-pyproject, setup-env, build, lint, format,
            test and package to their phases. A plain <plugin> entry is read too late for that,
            and the build fails with "Unknown packaging: python".

            Consuming projects need this block and nothing else — the goals come with it.
        -->
        <extensions>
            <extension>
                <groupId>com.github.realms42</groupId>
                <artifactId>python-maven-plugin</artifactId>
                <version>1.0.0-SNAPSHOT</version>
            </extension>
        </extensions>
    </build>
</project>
